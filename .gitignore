# Dependencies
node_modules/
package-lock.json

# Auto-downloaded CLIProxyAPI binaries (auto-fetched on first run by plugin)
cli-proxy-api/bin/*.exe
cli-proxy-api/bin/cli-proxy-api
cli-proxy-api/bin/*.zip
cli-proxy-api/bin/*.tar.gz
cli-proxy-api/bin/extract_tmp/
!cli-proxy-api/bin/.gitkeep
!cli-proxy-api/bin/version.json

# Runtime configurations and credentials generated by daemon
cli-proxy-api/config.yaml
cli-proxy-api/auths/*
!cli-proxy-api/auths/.gitkeep

# Logs
*.log
cli-proxy-api/*.log
cli-proxy-api/auths/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and OS files
.env
.env.*
.DS_Store
Thumbs.db
*.tmp
*.bak
